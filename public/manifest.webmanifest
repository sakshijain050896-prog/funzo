{
  "name": "Funzo — Super Mario World Gaming Hub",
  "short_name": "Funzo",
  "description": "Play engaging puzzle, brain, trivia and arcade games with Mario-inspired design!",
  "start_url": "/",
  "id": "/",
  "display": "standalone",
  "display_override": ["standalone", "fullscreen", "minimal-ui"],
  "background_color": "#5c94fc",
  "theme_color": "#e52521",
  "orientation": "portrait",
  "categories": ["games", "entertainment", "education"],
  "icons": [
    {
      "src": "/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-192-maskable.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/icons/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Play Quiz Up",
      "url": "/?game=quizup",
      "description": "Test your knowledge with 360+ trivia questions!"
    },
    {
      "name": "Play Maths Puzzle",
      "url": "/?game=sudoku",
      "description": "Brain arithmetic and logic challenges"
    },
    {
      "name": "Arrow Out",
      "url": "/?game=arrow",
      "description": "Untangle arrows without collision"
    }
  ]
}
